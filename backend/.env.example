# Server
PORT=3001
NODE_ENV=development

# PostgreSQL (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/asilia

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Default admin (created on first boot if none exists)
ADMIN_EMAIL=mimeanidawa@gmail.com
ADMIN_PASSWORD=unatumia6%

# Firebase Admin SDK — paste full service account JSON as a single line, or set path
# On Railway: add FIREBASE_SERVICE_ACCOUNT as a variable with the JSON content
FIREBASE_SERVICE_ACCOUNT=

# CORS — comma-separated origins (use * for dev only)
CORS_ORIGINS=*

# SonicPesa — backend only; never expose these values in Flutter
# Access Key (used as X-API-KEY header)
SONICPESA_ACCESS_KEY=
# Secret Key (used for webhook signature verification)
SONICPESA_SECRET_KEY=
# Shared SonicPesa webhook (one API for Washa TV + Asilia and other apps):
# https://washatv-production.up.railway.app/api/v1/webhooks/sonicpesa
# This Asilia service also accepts the same path:
# https://asilia-production.up.railway.app/api/v1/webhooks/sonicpesa
